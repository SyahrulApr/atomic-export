# RAG Copilot -- Postgres dengan extension pgvector aktif
# Opsi cepat lokal: `docker compose up -d` lalu pakai default di bawah ini
DATABASE_URL=postgresql://atomic:atomic@localhost:55432/atomic_export
# Opsi hosted (Supabase/Neon/DigitalOcean): ganti dengan connection string masing-masing

# RAG Copilot -- dipakai untuk embedding (text-embedding-3-small) & jawaban (gpt-4o-mini)
# Satu-satunya kredensial yang WAJIB didapat manual dari platform.openai.com
OPENAI_API_KEY=sk-...

# Setelah OPENAI_API_KEY diisi (dan docker compose up -d bila pakai DB lokal):
#   pnpm db:setup   -> aktifkan extension pgvector
#   pnpm db:push    -> sinkronkan schema (rag_documents, rag_chunks, copilot_queries)
#   pnpm db:ingest  -> proses corpus/regulasi jadi embedding (butuh kuota OpenAI)
